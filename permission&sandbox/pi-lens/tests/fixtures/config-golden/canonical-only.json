{
	"global": null,
	"lsp": {
		"ignore": [
			"dist/**"
		],
		"lsp": {
			"disabledServers": [
				"typos"
			],
			"servers": {
				"custom": {
					"args": [
						"--stdio"
					],
					"command": "custom-lsp",
					"extensions": [
